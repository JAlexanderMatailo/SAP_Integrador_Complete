<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA. Copiar a  Config\sapCompanies.config  y ajustar por entorno.
  El archivo real NO se versiona (ver .gitignore).

  IMPORTANTE: las credenciales de SAP las envía la API llamadora en las
  cabeceras de cada petición:

      X-SAP-User      usuario de SAP Business One
      X-SAP-Password  su clave

  El integrador NO custodia credenciales de SAP. Las claves Sap.Login.* de más
  abajo son solo un RESPALDO opcional, para pruebas locales o para un consumidor
  que todavía no envíe las cabeceras. En producción lo normal es dejarlas fuera.

  Las credenciales de HANA son otra cosa: son de un usuario técnico de base de
  datos y siguen en Web.config (UserHana / PwdHana).
-->
<appSettings>

  <!--
    LISTA BLANCA de bases de SAP habilitadas. Separadas por coma.

    Es una clave independiente de las credenciales a propósito: qué empresas se
    admiten es una decisión distinta de dónde salen los usuarios. Como las
    credenciales ahora llegan por cabecera, puede no haber ninguna entrada
    Sap.Login.* y aun así la lista de empresas sigue siendo cerrada.

    El CompanyDB llega por parámetro en cada petición (en la ruta o en el
    cuerpo) y se usa como nombre de esquema en HANA, así que se valida contra
    esta lista antes de tocar SAP o HANA.

    Vacía o ausente = sin restricción por nombre. La validación de caracteres
    (solo letras, dígitos y '_') se aplica siempre, venga lo que venga.
  -->
  <add key="Sap.CompanyDbPermitidas" value="SBO_AUTOLLANTA_PROD,SBO_MAXXIMUNDO_PROD,SBO_STOX_PROD,SBO_IKONIX_PROD" />

  <!--
  Las cuatro empresas reales y su clave corta en el sistema llamador:

  AUTOLLANTA  -> SBO_AUTOLLANTA_PROD
  MAXXIMUNDO  -> SBO_MAXXIMUNDO_PROD
  STOX        -> SBO_STOX_PROD
  IKONIX      -> SBO_IKONIX_PROD

El integrador NO traduce la clave corta: espera el CompanyDB completo. Quien
llame debe enviar "SBO_IKONIX_PROD", no "IKONIX".
  -->


  <!--
    OJO EN LA TRANSICIÓN. El consumidor actual (Api) sigue apuntando a este
    integrador, envía el CompanyDB desde su propia clave "datosSap:CompanyDB".
    Mientras conviva, agregue ese valor a la lista de arriba o deje la clave
    vacía para no restringir por nombre (la validación de caracteres sigue
    activa en cualquier caso).
  -->

  <!--
    RESPALDO opcional de credenciales, formato usuario|clave.
    Solo se consultan si la petición no trajo las cabeceras X-SAP-*.
    La clave se parte en el PRIMER '|', así que la contraseña puede llevar '|'.

    Las cuatro empresas usan el mismo usuario de Service Layer (WEB), asi que
    basta Sap.Login.Default para cubrirlas todas. OJO: al definir Default, la
    lista blanca de arriba SIGUE aplicando, porque son claves independientes.


    <add key="Sap.Login.Default" value="WEB|clave" />

    Descomente solo lo que necesite para pruebas:

      <add key="Sap.Login.SAP_MAXX" value="usuario|clave" />
      <add key="Sap.Login.SAP_IKO"  value="usuario|clave" />
      <add key="Sap.Login.SAP_AUT"  value="usuario|clave" />
      <add key="Sap.Login.SAP_STO"  value="usuario|clave" />

    Sap.Login.Default se usaría para cualquier CompanyDB sin entrada propia.
    No afecta a la lista blanca de arriba.

      <add key="Sap.Login.Default" value="usuario|clave" />
  -->

  <!--
    CREDENCIALES DE HANA. Obligatorias: sin ellas no hay ninguna lectura.

    Estaban en Web.config y se movieron aquí porque ese archivo se versiona y
    el repositorio es público. Son de un usuario técnico de base de datos, no
    del usuario de SAP que llega por cabecera.

    El servidor y el puerto (ServerHana / PortHana) siguen en Web.config: no
    son secretos y cambian por entorno junto con ServerSSL.
  -->
  <add key="UserHana" value="usuario_hana" />
  <add key="PwdHana" value="clave_hana" />

</appSettings>
