<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA. Copiar a  Config\sapCompanies.config  y completar.
  El archivo real NO se versiona (ver .gitignore).

      cp sapCompanies.example.config sapCompanies.config

  Este archivo contiene SOLO SECRETOS. Todo lo demas (ServerSSL, ServerHana,
  PortHana, Sap.CompanyDbPermitidas, timeouts) vive en Web.config, versionado:
  no son secretos y cada despliegue necesita verlos. Mantener una sola fuente
  para cada clave evita que la documentacion se desincronice.

  Las claves de este archivo SOBRESCRIBEN las de Web.config.
-->
<appSettings>

  <!--
    HANA. Usuario tecnico de BASE DE DATOS, obligatorio: sin el no hay ninguna
    lectura directa. Es INDEPENDIENTE del usuario de SAP Business One: el
    usuario que llega por cabecera sirve para el Service Layer, no para HANA.

    Necesita permiso de lectura sobre los esquemas que el integrador atienda
    (SBO_AUTOLLANTA_PROD, SBO_MAXXIMUNDO_PROD, SBO_STOX_PROD, SBO_IKONIX_PROD).
    Como Sap.CompanyDbPermitidas esta vacia en Web.config, el alcance de este
    usuario ES el control de acceso: no darle mas esquemas de los necesarios.

    El servidor y el puerto (ServerHana / PortHana) estan en Web.config.
  -->
  <add key="UserHana" value="usuario_hana" />
  <add key="PwdHana" value="clave_hana" />

  <!--
    SERVICE LAYER. OPCIONAL, solo respaldo para pruebas locales.

    En produccion las credenciales llegan en las cabeceras X-SAP-User y
    X-SAP-Password que envia la API consumidora, y tienen prioridad sobre lo que
    haya aqui. Sirve para usar Swagger sin escribir las cabeceras en cada
    llamada.

    Formato usuario|clave. Se parte en el PRIMER '|', asi que la clave puede
    contener '|'. Default cubre cualquier CompanyDB sin entrada propia:
  -->
  <add key="Sap.Login.Default" value="usuario|clave" />

  <!--
    Y si alguna empresa necesitara una credencial distinta, se declara por su
    CompanyDB completo (no por la clave corta AUTOLLANTA / IKONIX / ...):

      <add key="Sap.Login.SBO_AUTOLLANTA_PROD" value="usuario|clave" />
      <add key="Sap.Login.SBO_MAXXIMUNDO_PROD" value="usuario|clave" />
      <add key="Sap.Login.SBO_STOX_PROD"       value="usuario|clave" />
      <add key="Sap.Login.SBO_IKONIX_PROD"     value="usuario|clave" />
  -->

</appSettings>
