  <PropertyGroup>
    <!-- Ruta del cliente ADO.NET de SAP HANA.
         Antes era un HintPath relativo de profundidad fija (..\ x8) que solo
         resolvia si la solucion estaba exactamente a 8 niveles de C:\.
         Ahora se resuelve por propiedad y se puede sobreescribir:
             msbuild /p:HanaClientPath="D:\SAP\hdbclient\ado.net\v4.5" -->
    <!-- 1) el paquete NuGet SapHana, que es de donde sale realmente el driver
         (packages.config lo declara). Es la via por defecto. -->
    <HanaClientPath Condition=" '$(HanaClientPath)' == '' And Exists('$(MSBuildProjectDirectory)\..\packages\SapHana.1.0.3\lib\net45\Sap.Data.Hana.v4.5.dll') ">$(MSBuildProjectDirectory)\..\packages\SapHana.1.0.3\lib\net45</HanaClientPath>
    <!-- 2) el cliente HANA instalado en la maquina, si lo hay. -->
    <HanaClientPath Condition=" '$(HanaClientPath)' == '' And Exists('$(ProgramW6432)\SAP\hdbclient\ado.net\v4.5\Sap.Data.Hana.v4.5.dll') ">$(ProgramW6432)\SAP\hdbclient\ado.net\v4.5</HanaClientPath>
    <!-- 3) por defecto el paquete, para que el error diga que falta el restore. -->
    <HanaClientPath Condition=" '$(HanaClientPath)' == '' ">$(MSBuildProjectDirectory)\..\packages\SapHana.1.0.3\lib\net45</HanaClientPath>
    <!-- XML de documentacion: Swagger describe con el los modelos de request y
         respuesta. NoWarn 1591 evita los avisos por miembros sin comentario ///. -->
